# Copy to .env and adjust. Never commit .env.

POSTGRES_DB=supermarket
POSTGRES_USER=supermarket
POSTGRES_PASSWORD=supermarket
POSTGRES_PORT=5432

# Google AI Studio key for Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Secret used to sign login tokens, at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
