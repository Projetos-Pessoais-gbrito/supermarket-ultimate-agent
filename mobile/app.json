{
  "expo": {
    "name": "Supermarket Agent",
    "slug": "supermarket-agent",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gbrito.supermarketagent"
    },
    "android": {
      "package": "com.gbrito.supermarketagent",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Permita o acesso à câmera para escanear o QR code das suas notas fiscais.",
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permita o uso do Face ID para desbloquear o app com segurança."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso às fotos para importar notas fiscais a partir de imagens.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "supermarketagent",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ad727e16-6732-4c99-9be0-9785bbbdedbd"
      }
    },
    "owner": "gustavo_brito_2000"
  }
}
